  {
    "id": "EOC_CULT_GCW_SWORD_DUBHE",
    "type": "effect_on_condition",
    "eoc_type": "ACTIVATION",
    "//": "Sword of Dubhe activation (design §27.5). Unbonded → runs the bond EOC; bonded → release: 25 Qi, friendly flying pet for 30 minutes. Marker effect gates re-release. Hook: cult_gcw_released_dubhe.",
    "effect": [
      {
        "if": { "not": { "u_has_trait": "cult_gcw_dubhe" } },
        "then": [ { "run_eocs": [ "EOC_CULT_GCW_BOND_DUBHE" ] } ],
        "else": [
          {
            "if": { "u_has_effect": "effect_cult_gcw_flying_dubhe" },
            "then": [ { "u_message": "The Sword of Dubhe already flies beside you.", "type": "info" } ],
            "else": [
              {
                "if": { "math": [ "u_vitamin('cult_qi') >= 25" ] },
                "then": [
                  { "math": [ "u_vitamin('cult_qi') -= 25" ] },
                  { "u_add_effect": "effect_cult_gcw_flying_dubhe", "duration": "30 minutes" },
                  {
                    "u_spawn_monster": "mon_cult_gcw_dubhe",
                    "friendly": true,
                    "real_count": 1,
                    "min_radius": 1,
                    "max_radius": 2,
                    "lifespan": 1800
                  },
                  { "u_add_var": "cult_gcw_released_dubhe", "value": "yes" },
                  {
                    "u_message": "The Sword of Dubhe rises from your hand and takes its place in the air beside you.",
                    "type": "good"
                  }
                ],
                "else": [ { "u_message": "You lack the Qi to release the Sword of Dubhe.", "type": "bad" } ]
              }
            ]
          }
        ]
      }
    ]
  },
