[
  {
    "id": "EOC_CULT_GCW_LEARN",
    "type": "effect_on_condition",
    "eoc_type": "ACTIVATION",
    "//": "Grand Chariot Manual activation (design §27.3, §27.8). Teaching is gated on qi_sense per on-ramp doctrine; repeated use is a guarded no-op. Hook: cult_gcw_style_learned.",
    "effect": [
      {
        "if": { "and": [ { "u_has_trait": "qi_sense" }, { "not": { "u_has_martial_art": "style_cult_grand_chariot" } } ] },
        "then": [
          { "u_learn_martial_art": "style_cult_grand_chariot" },
          { "u_learn_recipe": "cult_sword_dubhe" },
          { "u_add_var": "cult_gcw_style_learned", "value": "yes" },
          {
            "u_message": "The star charts of the Grand Chariot unfold behind your eyes.  Your hands remember seven cuts that were never taught to you, and the forge-songs of the first star follow them.",
            "type": "good"
          }
        ],
        "else": [
          {
            "if": { "u_has_martial_art": "style_cult_grand_chariot" },
            "then": [
              { "u_message": "The forms of the Grand Chariot are already yours.  Rereading the charts adds nothing.", "type": "info" }
            ],
            "else": [
              {
                "u_message": "The diagrams refuse to move for you.  Without awakened qi, the doctrines of the Grand Chariot are so much ink and dead paper.",
                "type": "bad"
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "EOC_CULT_GCW_BOND_DUBHE",
    "type": "effect_on_condition",
    "eoc_type": "ACTIVATION",
    "//": "Bond Sword of Dubhe (design §27.3/§27.5). Gated on Qi Condensation + 100 Qi; grants chant, records bond count, teaches the next star's forge-song. Hook: cult_star_bonded + chant trait.",
    "effect": [
      {
        "if": {
          "and": [
            { "u_has_trait": "cult_realm_qi_condensation" },
            { "not": { "u_has_trait": "cult_gcw_dubhe" } },
            { "math": [ "u_vitamin('cult_qi') >= 100" ] }
          ]
        },
        "then": [
          { "math": [ "u_vitamin('cult_qi') -= 100" ] },
          { "u_add_trait": "cult_gcw_dubhe" },
          { "u_add_var": "cult_star_bonded", "value": "1" },
          { "u_learn_recipe": "cult_sword_merak" },
          {
            "u_message": "Dubhe, the first star, binds itself to your dantian.  The sword remembers its name.",
            "type": "good"
          }
        ],
        "else": [
          {
            "if": { "u_has_trait": "cult_gcw_dubhe" },
            "then": [ { "u_message": "Dubhe is already bound to you.", "type": "info" } ],
            "else": [
              {
                "u_message": "Dubhe will not bind to you yet.  You need a Qi Condensation realm and at least 100 Qi to spare.",
                "type": "bad"
              }
            ]
          }
        ]
      }
    ]
  },
