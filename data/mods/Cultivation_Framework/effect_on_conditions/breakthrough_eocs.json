[
  {
    "id": "EOC_CULT_BREAK_QI_COND",
    "type": "effect_on_condition",
    "eoc_type": "ACTIVATION",
    "//": "Entry realm: Qi Sense + a half-full dantian. No pill. Impure body = failed condensation (uniform fail rule, design \u00a716.6).",
    "condition": { "and": [ { "u_has_trait": "qi_sense" }, { "math": [ "u_vitamin('cult_qi') >= 50" ] } ] },
    "effect": [
      {
        "if": { "math": [ "u_vitamin('cult_impure_qi') >= 600" ] },
        "then": [
          { "math": [ "u_vitamin('cult_xp_generic') = u_vitamin('cult_xp_generic') / 2" ] },
          { "u_add_effect": "effect_cult_meridian_wound", "duration": "30 days" },
          { "math": [ "u_vitamin('cult_impure_qi') += 150" ] },
          { "u_message": "The Qi rebels and scatters.  Your meridians tear.", "type": "bad" },
          { "u_add_var": "cult_breakthrough_qi_cond_fail", "value": "yes" }
        ],
        "else": [
          { "u_add_trait": "cult_realm_qi_condensation" },
          { "math": [ "u_val('thirst') += 300" ] },
          { "math": [ "u_calories() -= 1500" ] },
          { "u_learn_recipe": "cult_pill_foundation" },
          { "u_message": "The ember catches.  You are a cultivator.  Hunger claws at you.", "type": "good" },
          { "u_add_var": "cult_breakthrough_qi_cond_success", "value": "yes" }
        ]
      }
    ]
  },
